  "report": {
    "headline": "A 28-minute flight at about 50 m, out to about 800 m north of take-off. The drone found Arabian oryx in 9 places (the largest herd at least 7) and reem gazelle in 1 place (at least 4). 2 incidents need attention: truck in a mixed herd at minute 17; oryx alert with the drone close at minute 21.",
    "flight": [
      {
        "stage": "S1",
        "text": "After take-off the drone flew north-east and passed 4 calm places with Arabian oryx between about 150 m and 650 m out, the largest herd at least 7."
      },
      {
        "stage": "S2",
        "text": "At about 800 m north-east of take-off it found a mixed herd of at least 4 reem gazelle and 3 Arabian oryx; a truck was seen inside the herd."
      },
      {
        "stage": "S3",
        "text": "The drone then found a herd of at least 5 Arabian oryx; an animal crossed quickly on its own, away from the others."
      },
      {
        "stage": "S4",
        "text": "After turning back the drone flew north and passed a single Arabian oryx about 750 m north of take-off."
      },
      {
        "stage": "S5",
        "text": "It then found a herd of at least 2 Arabian oryx about 550 m north of take-off; an animal stayed alert with the drone close for much of the time."
      },
      {
        "stage": "S6",
        "text": "Finally, the drone found a herd of at least 2 Arabian oryx about 300 m north of take-off; animals went in and out of cover at times."
      }
    ],
    "incidents": [
      {
        "incident": "I1",
        "text": "At minute 17 a truck was seen inside a mixed herd of at least 4 reem gazelle and 3 Arabian oryx about 800 m north-east of take-off. The animals ran (severe disturbance). The cause was a vehicle.",
        "follow_up": "Rangers should check whether the truck was allowed in the reserve at that place and time."
      },
      {
        "incident": "I2",
        "text": "At minute 21 an animal stayed alert with the drone close for much of the time in a herd of at least 2 Arabian oryx about 550 m north of take-off.",
        "follow_up": "Rangers should fly the drone farther from this herd on the next flight."
      }
    ],
    "closing": "The rest of the flight was calm; counts are minimums and animals under trees may be missed."
  }
